  "files": [
    {
      "file": "00_hook.mp3",
      "text": "Di sakunya cuma kertas: TAMAM SHUD. Tidak ada dompet, tidak ada nama.",
      "bytes": 126764,
      "seconds": 5.229,
      "sha256": "0dd80412ccdd0a20656fde33eddbbf6a43fda9f15c9e3718e4e9004d78d46f94"
    },
    {
      "file": "01_tanya.mp3",
      "text": "Coba lihat dua kata ini. Ada yang bisa kamu baca?",
      "bytes": 104876,
      "seconds": 4.318,
      "sha256": "f42ea107d0f8fa2b204f70f5bd74934adcb29b1d8c596f3a3d6bfe6c5142e6c6"
    },
    {
      "file": "02_relate.mp3",
      "text": "Kita tinggalkan nama di setiap benda. Dia mencopot semuanya.",
      "bytes": 97388,
      "seconds": 3.994,
      "sha256": "bb5ff64345dcd29c82c3cf2385c1725fec01d254676d1db7d5b1f6dfca976d62"
    },
    {
      "file": "03_setup.mp3",
      "text": "Desember 1948, pantai Somerton, Australia. Pria rapi, tanpa luka.",
      "bytes": 110636,
      "seconds": 4.546,
      "sha256": "c69c9d63b827fb02ce5cf659cfa469f56d7ff0ef8dd1f0fc7e26f33688c34691"
    },
    {
      "file": "04_tension.mp3",
      "text": "Lihat pakaiannya. Setiap label dipotong.",
      "bytes": 55916,
      "seconds": 2.268,
      "sha256": "e4f204e648865a10f1efdf647ab266a4bb5f54c805d22856ce9310ba51788dad"
    },
    {
      "file": "05_tension.mp3",
      "text": "Kertas itu sobekan dari buku puisi. Sisa halaman penuh huruf acak.",
      "bytes": 111788,
      "seconds": 4.598,
      "sha256": "75418b040590d85008fc0c8b7b819c71a711b2e3049c21dc41083e9bb05ab67c"
    },
    {
      "file": "06_turn.mp3",
      "text": "Tujuh puluh tahun dia disebut mata-mata. Lalu DNA bilang lain.",
      "bytes": 108332,
      "seconds": 4.458,
      "sha256": "78fd39a4d1a09f34e2289477e68b5e682b228f16a8f50fe9214e0751807cd33f"
    },
    {
      "file": "07_consequence.mp3",
      "text": "Dia teknisi listrik dari Melbourne. Namanya Carl Webb.",
      "bytes": 85292,
      "seconds": 3.492,
      "sha256": "9dc5f628b8bf94fca29ec11f557982c148536e2542ef45344c67023e3b30ea30"
    },
