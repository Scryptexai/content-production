{
  "episode": "EP08",
  "voice_id": "ojz6ro9PB1xDu44lymdM",
  "narration_seconds": 60.415,
  "files": [
    {
      "file": "00_hook.mp3",
      "text": "Kenapa semua label di bajunya dipotong, sebelum dia hilang?",
      "bytes": 93932,
      "seconds": 3.855,
      "sha256": "d9a3208be8900c104bd352fce51ae3683751a850a6659afd2b86bb9b99639798"
    },
    {
      "file": "01_tanya.mp3",
      "text": "Kalau kamu punya delapan nama. Yang mana yang kamu pakai pulang?",
      "bytes": 115820,
      "seconds": 4.769,
      "sha256": "3d6ad6749b448cfa19265abf916efc0f7884cbe630b67b00fd16779d95ea32b4"
    },
    {
      "file": "02_relate.mp3",
      "text": "Kita sembunyikan nama di internet. Dia pakai gunting.",
      "bytes": 90476,
      "seconds": 3.715,
      "sha256": "74c04cf39a84bc9a94efa2077d8df4aa7e8158aa2237b7fcf43effb618e436c2"
    },
    {
      "file": "03_setup.mp3",
      "text": "November 1970, lembah Isdalen, Norwegia. Ada perempuan terbakar di atas batu.",
      "bytes": 116396,
      "seconds": 4.786,
      "sha256": "8c987e2edca112856ce7f4e924bd3921a0e713093881c1357471e7f2826a5798"
    },
    {
      "file": "04_tension.mp3",
      "text": "Tubuhnya hangus dari depan. Punggungnya utuh.",
      "bytes": 63980,
      "seconds": 2.612,
      "sha256": "b963eddb2c7ff018273658eec8e8f462abb017a570397d98026cd52133d06c99"
    },
    {
      "file": "05_tension.mp3",
      "text": "Ada jelaga di paru-parunya. Dia masih hidup waktu api menyala.",
      "bytes": 104876,
      "seconds": 4.319,
      "sha256": "48b7ccbf9177bbd3545f419f2f896c9b4a5375807fe7bcd96fbc6cb6c7544da5"
    },
    {
      "file": "06_tension.mp3",
      "text": "Lihat botolnya. Tandanya dikerok semua.",
      "bytes": 53612,
      "seconds": 2.175,
      "sha256": "72331fa6c9dcbbd1bc60e4722654e2e4a69741cf6c16e99f950f44117dd3844c"
    },
    {
      "file": "07_turn.mp3",
      "text": "Polisi bilang bunuh diri. Tapi orang mau mati nggak potong label.",
      "bytes": 109484,
      "seconds": 4.505,
      "sha256": "d75472dfb43322dc6bb1f66c30ff6091012408264d4143a9fd5ccf510e524b4a"
    },
    {
      "file": "08_consequence.mp3",
      "text": "Coba lihat kopernya di stasiun: wig, peta, uang asing.",
      "bytes": 104300,
      "seconds": 4.273,
      "sha256": "2c56bc6de3d4be3ed772c1d16ddfa22b55c5d378c03592509ce292338b17f201"
    },
    {
      "file": "09_consequence.mp3",
      "text": "Empat puluh enam tahun kemudian, giginya bilang: Jerman.",
      "bytes": 84716,
      "seconds": 3.467,
      "sha256": "f0ced1f4480904ebc63c265c0b30a3cac83fe28ec7ac1ed03c2fc80a9c52853a"
    },
    {
      "file": "10_consequence.mp3",
      "text": "Namanya nggak pernah ada. Yang hilang cuma label.",
      "bytes": 81836,
      "seconds": 3.344,
      "sha256": "2c3aaa518ae32205adc7257059347a4ba0920de4f3bde5f87688591f1f6dcd6f"
    },
    {
      "file": "99_loop.mp3",
      "text": "Semua label hilang. Kamu nggak akan pernah tahu namanya.",
      "bytes": 90476,
      "seconds": 3.715,
      "sha256": "a11fc0b588f7b3ae2d7c670cb75381140ab639a807453b941dc5208507b062d0"
    },
