{
  "episode": "EP08",
  "voice_id": "ojz6ro9PB1xDu44lymdM",
  "narration_seconds": 62.901,
  "files": [
    {
      "file": "00_hook.mp3",
      "text": "Kenapa semua label di bajunya dipotong, sebelum dia hilang?",
      "bytes": 67752,
      "seconds": 4.18,
      "sha256": "58ae54f9fbe6f3161de78c5f6dcddce111a7cad754adb721f99591fd47d10e5c"
    },
    {
      "file": "01_tanya.mp3",
      "text": "Kalau kamu punya delapan nama. Yang mana yang kamu pakai pulang?",
      "bytes": 67334,
      "seconds": 4.133,
      "sha256": "6e2bd8a68eb9c022a0bed5e634cdd67d5b081b712c52adce02ab9cbdd3451a1c"
    },
    {
      "file": "02_relate.mp3",
      "text": "Kita sembunyikan nama di internet. Dia pakai gunting.",
      "bytes": 59811,
      "seconds": 3.669,
      "sha256": "1dec397a7180b2fa0db38458cdae8a49b0ea1869e79e63403fa947425f398ef1"
    },
    {
      "file": "03_setup.mp3",
      "text": "November 1970, lembah Isdalen, Norwegia. Ada perempuan terbakar di atas batu.",
      "bytes": 100771,
      "seconds": 6.223,
      "sha256": "a60e7eb5df6cc6567c9b777582dcdc59edb162c7f901b7e17ea655d7f4b654cd"
    },
    {
      "file": "04_tension.mp3",
      "text": "Tubuhnya hangus dari depan. Punggungnya utuh.",
      "bytes": 54377,
      "seconds": 3.344,
      "sha256": "ac2e39ab4dfa09d71c122b4e050c869222ba02e7b24d9131eecc1b42ac64c1c8"
    },
    {
      "file": "05_tension.mp3",
      "text": "Ada jelaga di paru-parunya. Dia masih hidup waktu api menyala.",
      "bytes": 66498,
      "seconds": 4.087,
      "sha256": "e3d0b678de6dfdeaf36e1917e87f465439f3bce190d5788eef696ecdbefdbe77"
    },
    {
      "file": "06_tension.mp3",
      "text": "Lihat botolnya. Tandanya dikerok semua.",
      "bytes": 45600,
      "seconds": 2.786,
      "sha256": "abff27ed88186f2beb4b9b142c537950a71df4390507bd004ea596f19bfc945c"
    },
    {
      "file": "07_turn.mp3",
      "text": "Polisi bilang bunuh diri. Tapi orang mau mati nggak potong label.",
      "bytes": 64826,
      "seconds": 3.994,
      "sha256": "e3ae53d5ec0c908a6f1bb1c6c83c5d2d4875344fe5c415d149dd9e88a4dc8ac8"
    },
    {
      "file": "08_consequence.mp3",
      "text": "Coba lihat kopernya di stasiun: wig, peta, uang asing.",
      "bytes": 66498,
      "seconds": 4.087,
      "sha256": "67041541aa385acae64451164a841658f32ace142a3d82bd7b7e325e52125ecb"
    },
    {
      "file": "09_consequence.mp3",
      "text": "Empat puluh enam tahun kemudian, giginya bilang: Jerman.",
      "bytes": 62736,
      "seconds": 3.855,
      "sha256": "bd332899218d0249868fb49f2f70f6d4f10eca4c656e9aadc00224557de2a100"
    },
    {
      "file": "10_consequence.mp3",
      "text": "Namanya nggak pernah ada. Yang hilang cuma label.",
      "bytes": 59811,
      "seconds": 3.669,
      "sha256": "d4b5020c43f673ece57d8252d557a3ab76b55134cc0200bd18d52ab8524cceb7"
    },
    {
      "file": "99_loop.mp3",
      "text": "Semua label hilang. Kamu nggak akan pernah tahu namanya.",
      "bytes": 64826,
      "seconds": 3.994,
      "sha256": "c969fa8ca4bde4a27c3bbc1f60e2a6c942f5761e3c95a411465527fe30b03ca2"
    },
