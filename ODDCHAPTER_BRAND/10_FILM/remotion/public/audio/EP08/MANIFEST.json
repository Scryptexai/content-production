    },
    {
      "file": "03_setup.mp3",
      "text": "Tahun 1970, lembah Isdalen, Norwegia. Ada perempuan terbakar di atas batu.",
      "bytes": 116396,
      "seconds": 4.787,
      "sha256": "d73da9d23d4b657b7b9bc1d4ac2f99ac67065a7f14e4fa19c3e4539525b58fa3"
    },
    {
      "file": "04_tension.mp3",
      "text": "Tubuhnya hangus dari depan. Punggungnya utuh.",
      "bytes": 70316,
      "seconds": 2.879,
      "sha256": "b66bb134580ec4eed4f0e06751ad1b11412a3f588c2127c8b06155c228324664"
    },
    {
      "file": "05_tension.mp3",
      "text": "Ada jelaga di paru-parunya. Dia masih hidup waktu api menyala.",
      "bytes": 103148,
      "seconds": 4.226,
      "sha256": "567a1929ca7d06692cc9a22800537590f10767ed968f95aa9c94059d19668239"
    },
    {
      "file": "06_turn.mp3",
      "text": "Orang mau mati tidak memotong label. Tidak mengerok tanda di botol.",
