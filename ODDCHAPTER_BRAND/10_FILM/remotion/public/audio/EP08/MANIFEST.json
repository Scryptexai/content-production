    },
    {
      "file": "01_tanya.mp3",
      "text": "Coba lihat delapan nama ini. Yang mana yang kamu pakai pulang?",
      "bytes": 107180,
      "seconds": 4.412,
      "sha256": "56f120099eb40b6f6232065d4d3815fa1ba35c71c4293c7cfc0f149215cfb5b8"
    },
    {
      "file": "02_relate.mp3",
      "text": "Kita sembunyikan nama di internet. Dia pakai gunting.",
