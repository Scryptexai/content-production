{
  "episode": "EP08",
  "voice_id": "ojz6ro9PB1xDu44lymdM",
  "narration_seconds": 63.317,
  "files": [
    {
      "file": "00_hook.mp3",
      "text": "Kenapa semua label di bajunya dipotong, sebelum dia hilang?",
      "bytes": 64408,
      "seconds": 3.947,
      "sha256": "1e4a36ed8644aa6f5b320c9e046c205c04383498849a419085e6ac996d1a8f24"
    },
    {
      "file": "01_tanya.mp3",
      "text": "Kalau kamu punya delapan nama. Yang mana yang kamu pakai pulang?",
      "bytes": 59811,
      "seconds": 3.669,
      "sha256": "45f56c936f1e74ac2b5f80b601d83d0e9cfb9a517f9bef9047338d33321541dd"
    },
    {
      "file": "02_relate.mp3",
      "text": "Kita sembunyikan nama di internet. Dia pakai gunting.",
      "bytes": 61065,
      "seconds": 3.762,
      "sha256": "bb9293af690ad1a24115a947372c816ebea07cdd4ced63288ee4ff6e98a30cd0"
    },
    {
      "file": "03_setup.mp3",
      "text": "November 1970, lembah Isdalen, Norwegia. Ada perempuan terbakar di atas batu.",
      "bytes": 99935,
      "seconds": 6.177,
      "sha256": "7c7fcaf7c134ad331134c8401f563450cc20f7fa054ebd6d704f57ecd76a9010"
    },
    {
      "file": "04_tension.mp3",
      "text": "Tubuhnya hangus dari depan. Punggungnya utuh.",
      "bytes": 51034,
      "seconds": 3.111,
      "sha256": "e1fcfb0c05c9936450782468760b228f04ec777346713446373721bafecbe5af"
    },
    {
      "file": "05_tension.mp3",
      "text": "Ada jelaga di paru-parunya. Dia masih hidup waktu api menyala.",
      "bytes": 67752,
      "seconds": 4.18,
      "sha256": "cf0f87e4b3ad601ace754f46df3bc3bd7b210801911384487dc3c353681c8b91"
    },
    {
      "file": "06_tension.mp3",
      "text": "Lihat botolnya. Tandanya dikerok semua.",
      "bytes": 51034,
      "seconds": 3.111,
      "sha256": "97bc14facf4e56c6460fe77440709594b5ff6bed4fc3743247637135b10d9f36"
    },
    {
      "file": "07_turn.mp3",
      "text": "Polisi bilang bunuh diri. Tapi orang mau mati nggak potong label.",
      "bytes": 68588,
      "seconds": 4.226,
      "sha256": "50b363d20122f2c236a2c98e5f0bb1c1cce3c91a8a8e489911077df2a9716f3b"
    },
    {
      "file": "08_consequence.mp3",
      "text": "Coba lihat kopernya di stasiun: wig, peta, uang asing.",
      "bytes": 70260,
      "seconds": 4.319,
      "sha256": "64e9516cf87b4937153d9e033c690c6ec2ef71b396277f4ff52e168781ed4803"
    },
    {
      "file": "09_consequence.mp3",
      "text": "Empat puluh enam tahun kemudian, giginya bilang: Jerman.",
      "bytes": 60647,
      "seconds": 3.715,
      "sha256": "ea85f7c8991a7ebd18771e1d62c3054de4f540f5f4b9a0f3892669bd1cb3e0e7"
    },
    {
      "file": "10_consequence.mp3",
      "text": "Namanya nggak pernah ada. Yang hilang cuma label.",
      "bytes": 64826,
      "seconds": 3.994,
      "sha256": "73554262c944051146396f40b18fd76363aa46863025a2ee981436d8a9f45d3a"
    },
    {
      "file": "99_loop.mp3",
      "text": "Semua label hilang. Kamu nggak akan pernah tahu namanya.",
      "bytes": 68588,
      "seconds": 4.226,
      "sha256": "0d792d9b66c293735917f2f232759fa1cc5b88de8d06877b30e77162c2e38134"
    },
