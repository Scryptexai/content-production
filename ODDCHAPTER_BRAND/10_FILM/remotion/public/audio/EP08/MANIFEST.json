{
  "episode": "EP08",
  "voice_id": "ojz6ro9PB1xDu44lymdM",
  "narration_seconds": 66.839,
  "files": [
    {
      "file": "00_hook.mp3",
      "text": "Kenapa semua label di bajunya dipotong, sebelum dia hilang?",
      "bytes": 96236,
      "seconds": 3.947,
      "sha256": "482634deda5c784cf7dae4ecd7ab47aaf42f24e2e3eec5be529bb505abcbb12c"
    },
    {
      "file": "01_tanya.mp3",
      "text": "Kalau kamu punya delapan nama. Yang mana yang kamu pakai pulang?",
      "bytes": 81260,
      "seconds": 3.329,
      "sha256": "6d91bf4f938d769b680469fbb459a05aed9ff42a2dec3b8f6d7208a8f34029d0"
    },
    {
      "file": "02_relate.mp3",
      "text": "Kita sembunyikan nama di internet. Dia pakai gunting.",
      "bytes": 90476,
      "seconds": 3.715,
      "sha256": "c9a2d1dc072e063084a4a9a120fc05fc6398c9da69f23868af8a7d26c4c63fdb"
    },
    {
      "file": "03_setup.mp3",
      "text": "November 1970, lembah Isdalen, Norwegia. Ada perempuan terbakar di atas batu.",
      "bytes": 233324,
      "seconds": 9.657,
      "sha256": "86de7f87d33cd857cad81051b347029c746c780bf8c51ac16b32e3488c40de9f"
    },
    {
      "file": "04_tension.mp3",
      "text": "Tubuhnya hangus dari depan. Punggungnya utuh.",
      "bytes": 84716,
      "seconds": 3.47,
      "sha256": "efbdd6b8a4f5ec138fa3fa0b7b54199f7b1d38c0dc8b772742492cc56a28d8e3"
    },
    {
      "file": "05_tension.mp3",
      "text": "Ada jelaga di paru-parunya. Dia masih hidup waktu api menyala.",
      "bytes": 112940,
      "seconds": 4.644,
      "sha256": "6d0f869245c20e63c560c05152f151efc4a13d6d2f6ffecb0b0311fad296a726"
    },
    {
      "file": "06_tension.mp3",
      "text": "Lihat botolnya. Tandanya dikerok semua.",
      "bytes": 86444,
      "seconds": 3.546,
      "sha256": "c00f4d551cb3451eef845cd8306677d0e758e8265aaeb5ddcbc2fa113faa22f7"
    },
    {
      "file": "07_turn.mp3",
      "text": "Polisi bilang bunuh diri. Tapi orang mau mati nggak potong label.",
      "bytes": 80108,
      "seconds": 3.269,
      "sha256": "b7b4acd6fda6d570d8190dffe35c1b7761b17670d5a99cb15790f3e14b2b1b57"
    },
    {
      "file": "08_consequence.mp3",
      "text": "Coba lihat kopernya di stasiun: wig, peta, uang asing.",
      "bytes": 101996,
      "seconds": 4.18,
      "sha256": "869c000442f1d5fa385e74cb8a00fe66f61187315762f93dd1d351a4e6376606"
    },
    {
      "file": "09_consequence.mp3",
      "text": "Empat puluh enam tahun kemudian, giginya bilang: Jerman.",
      "bytes": 93932,
      "seconds": 3.855,
      "sha256": "22614fe5e97123899fda547f17c41be09e86946ff9e2791b922d2e7c58a70f2b"
    },
    {
      "file": "10_consequence.mp3",
      "text": "Namanya nggak pernah ada. Yang hilang cuma label.",
      "bytes": 85292,
      "seconds": 3.483,
      "sha256": "8d6c079b4ee3451cca21e5c85dba518773449bbae2c6719626d4b8ad8a167b03"
    },
    {
      "file": "99_loop.mp3",
      "text": "Semua label hilang. Kamu nggak akan pernah tahu namanya.",
      "bytes": 118124,
      "seconds": 4.864,
      "sha256": "f30e4022ed74c574cecbb7afb42c5db11dcd3e4de51cfb4bee297a5e98a5dc83"
    },
