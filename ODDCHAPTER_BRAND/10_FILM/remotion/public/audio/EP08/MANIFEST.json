      "seconds": 4.551,
      "sha256": "aa9d012577846608671b7d2030199b6f4f0196fea22700724069a60e7b31841d"
    },
    {
      "file": "07_consequence.mp3",
      "text": "Lihat kopernya. Wig, uang asing, delapan nama.",
