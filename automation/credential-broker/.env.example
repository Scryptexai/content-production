# ============================================================
# Credential Broker — contoh konfigurasi
# Salin ke .env (JANGAN commit) atau isi sebagai Environment
# Variables di Vercel. Aturan repo: tidak ada kredensial di git.
# ============================================================

# --- Permit.io (wajib) ---
# API key environment Permit. Ini kunci rahasia — hanya di server.
PERMIT_API_KEY=

# URL Policy Decision Point. Kosongkan untuk memakai Cloud PDP.
# Penting: permission check TIDAK lewat api.permit.io, tapi ke PDP ini.
#   cloud  : https://cloudpdp.api.permit.io   (default)
#   lokal  : http://localhost:7766            (container PDP, tidak untuk Vercel)
PERMIT_PDP_URL=https://cloudpdp.api.permit.io

# --- Identitas pemanggil (minimal satu) ---
# Token statis untuk service internal: {"token-rahasia":"service:reporting"}
BROKER_STATIC_TOKENS=

# Untuk user yang login lewat Supabase (JWT HS256). JWT diverifikasi lokal,
# tidak perlu round-trip ke Supabase.
SUPABASE_JWT_SECRET=

# --- Vault rahasia asli ---
# env      : rahasia dibaca dari environment variable (paling sederhana)
# supabase : rahasia dibaca dari Supabase Vault via RPC
VAULT_PROVIDER=env

# Kalau VAULT_PROVIDER=env, isi rahasia per upstream di sini:
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
SLACK_BOT_TOKEN=

# --- Supabase (wajib kalau vault/audit memakai supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAULT_RPC=get_secret

# --- Audit ---
# console  : log JSON terstruktur
# supabase : INSERT ke tabel audit
# none     : matikan (tidak disarankan)
AUDIT_PROVIDER=console
AUDIT_TABLE=credential_audit

# --- Batas operasional ---
REQUEST_TIMEOUT_MS=15000
MAX_BODY_BYTES=1048576
# Untuk mode claim: berapa lama kunci boleh diambil. Kunci statis pihak ketiga
# tetap berlaku sampai dirotasi — angka ini hanya batas reveal, bukan masa berlaku kunci.
CLAIM_TTL_SECONDS=300
