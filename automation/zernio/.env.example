# Salin ke automation/zernio/.env — JANGAN pernah commit nilai asli.
# Tidak ada satu pun token di repo ini.

# API key dari https://zernio.com/dashboard/api-keys
ZERNIO_API_KEY=
# Profile id di dashboard Zernio (dipakai di semua panggilan /v1)
ZERNIO_PROFILE_ID=

# Alternatif pemetaan channel → account id (kalau tidak memakai .zernio-mapping.json)
ZERNIO_CHANNEL_BEAUTY_YOUTUBE=
ZERNIO_CHANNEL_BEAUTY_TIKTOK=
ZERNIO_CHANNEL_BEAUTY_INSTAGRAM=
ZERNIO_CHANNEL_RELATIONSHIP_YOUTUBE=
ZERNIO_CHANNEL_RELATIONSHIP_TIKTOK=
ZERNIO_CHANNEL_RELATIONSHIP_INSTAGRAM=

# 1 = kirim field title untuk YouTube (set 0 kalau API menolak field tambahan)
ZERNIO_SEND_TITLE=1

# Fallback bila presign media gagal (opsional)
SITE_BASE_URL=
